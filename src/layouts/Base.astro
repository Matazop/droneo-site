---
import '@fontsource/montserrat/600.css';
import '@fontsource/montserrat/700.css';
import '@fontsource/montserrat/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const fullTitle = title.includes('Droneo') ? title : `${title} | Droneo`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname;
const nav = [
  { href: '/particuliers/', label: 'Particuliers' },
  { href: '/professionnels/', label: 'Professionnels' },
  { href: '/realisations/', label: 'Réalisations' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/faq/', label: 'FAQ' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Droneo',
  description: 'Vidéos et photos aériennes par drone sur mesure, par un télépilote certifié, en Vendée et Pays de la Loire.',
  url: 'https://droneo.fr/',
  image: 'https://droneo.fr/img/logo-fond-blanc.png',
  email: site.email,
  telephone: site.phoneIntl,
  areaServed: ['Vendée', 'Pays de la Loire'],
  founder: { '@type': 'Person', name: site.pilot },
};
---
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#00274d" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL('/img/logo-fond-bleu.png', Astro.site)} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="header" id="header">
    <div class="wrap header__inner">
      <a href="/" class="brand" aria-label="Droneo, accueil">
        <img src="/img/logo-mark-dark.png" alt="" width="40" height="40" />
        <span>DRONEO</span>
      </a>
      <nav class="nav" id="nav" aria-label="Navigation principale">
        {nav.map((n) => (
          <a href={n.href} aria-current={path.startsWith(n.href) ? 'page' : undefined}>{n.label}</a>
        ))}
        <a href="/devis/" class="btn btn--primary nav__cta">Demander un devis</a>
      </nav>
      <button class="burger" id="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </header>

  <main id="contenu">
    <slot />
  </main>

  <footer class="footer">
    <div class="wrap footer__grid">
      <div>
        <img src="/img/logo-full-dark.png" alt="Droneo" width="120" height="121" />
        <p class="footer__tag">Vidéos aériennes sur mesure par {site.pilot}, télépilote certifié.</p>
      </div>
      <div>
        <h4>Prestations</h4>
        <a href="/particuliers/">Particuliers et mariages</a>
        <a href="/professionnels/#immobilier">Immobilier</a>
        <a href="/professionnels/#tourisme">Tourisme et hébergement</a>
        <a href="/professionnels/#entreprise">Entreprises</a>
        <a href="/professionnels/#evenementiel">Événementiel et sport</a>
      </div>
      <div>
        <h4>Droneo</h4>
        <a href="/realisations/">Réalisations</a>
        <a href="/a-propos/">À propos</a>
        <a href="/faq/">Questions fréquentes</a>
        <a href="/devis/">Demander un devis</a>
      </div>
      <div>
        <h4>Contact</h4>
        <a href={`tel:${site.phoneIntl}`}><Icon name="phone" size={18} /> {site.phone}</a>
        <a href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a>
        <a href={site.instagram} rel="noopener" target="_blank"><Icon name="instagram" size={18} /> Instagram</a>
        <span><Icon name="pin" size={18} /> {site.zone}</span>
      </div>
    </div>
    <div class="wrap footer__bottom">
      <span>© {new Date().getFullYear()} Droneo · {site.pilot}</span>
      <span><a href="/mentions-legales/">Mentions légales</a> · <a href="/confidentialite/">Confidentialité</a></span>
    </div>
  </footer>

  <div class="mobile-bar" aria-label="Contact rapide">
    <a href={`tel:${site.phoneIntl}`}><Icon name="phone" size={20} /> Appeler</a>
    <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp</a>
    <a href="/devis/" class="mobile-bar__cta">Devis gratuit</a>
  </div>

  <script is:inline>
    const h = document.getElementById('header');
    const onScroll = () => h.classList.toggle('scrolled', window.scrollY > 30);
    onScroll(); window.addEventListener('scroll', onScroll, { passive: true });
    const b = document.getElementById('burger');
    b.addEventListener('click', () => {
      const open = document.body.classList.toggle('menu-open');
      b.setAttribute('aria-expanded', open);
      b.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    });
    const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }), { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>

<style is:global>
  .skip { position: absolute; left: -9999px; top: 8px; z-index: 100; background: #fff; padding: 8px 14px; border-radius: 8px; }
  .skip:focus { left: 8px; }
  .header { position: fixed; inset: 0 0 auto; z-index: 50; transition: background .25s, box-shadow .25s, padding .25s; padding: 18px 0; }
  .header.scrolled, body.menu-open .header { background: rgba(0, 39, 77, .96); backdrop-filter: blur(8px); box-shadow: 0 6px 24px rgba(0,0,0,.18); padding: 10px 0; }
  .header__inner { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #fff; font-family: var(--font-title); font-weight: 800; font-size: 1.35rem; letter-spacing: .04em; text-decoration: none !important; }
  .nav { display: flex; align-items: center; gap: 26px; }
  .nav a:not(.btn) { color: #e3edf9; font-family: var(--font-title); font-weight: 600; font-size: .95rem; text-decoration: none; position: relative; }
  .nav a:not(.btn):hover, .nav a[aria-current] { color: #fff; }
  .nav a[aria-current]::after { content: ''; position: absolute; left: 0; right: 0; bottom: -6px; height: 2px; background: var(--blue); border-radius: 2px; }
  .nav__cta { padding: 11px 20px; font-size: .9rem; }
  .burger { display: none; background: none; border: 0; width: 44px; height: 44px; padding: 10px; cursor: pointer; }
  .burger span { display: block; height: 2px; background: #fff; margin: 6px 0; border-radius: 2px; transition: transform .2s, opacity .2s; }
  body.menu-open .burger span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  body.menu-open .burger span:nth-child(2) { opacity: 0; }
  body.menu-open .burger span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }
  @media (max-width: 960px) {
    .burger { display: block; }
    .nav { position: fixed; inset: 64px 0 auto; background: var(--navy); flex-direction: column; align-items: stretch; gap: 0; padding: 12px 16px 24px; transform: translateY(-120%); transition: transform .25s; max-height: calc(100vh - 64px); overflow: auto; }
    body.menu-open .nav { transform: none; }
    .nav a:not(.btn) { padding: 14px 4px; border-bottom: 1px solid rgba(255,255,255,.08); font-size: 1.05rem; }
    .nav a[aria-current]::after { display: none; }
    .nav__cta { margin-top: 16px; justify-content: center; }
  }

  .footer { background: var(--navy-900); color: #a9bdd6; padding: 72px 0 0; font-size: .95rem; }
  .footer__grid { display: grid; gap: 36px; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); }
  .footer h4 { color: #fff; font-size: .9rem; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 16px; }
  .footer a, .footer span { display: flex; align-items: center; gap: 8px; color: #a9bdd6; padding: 4px 0; }
  .footer a:hover { color: #fff; }
  .footer__tag { margin-top: 16px; max-width: 260px; }
  .footer__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; border-top: 1px solid rgba(255,255,255,.08); margin-top: 48px; padding: 22px 0 28px; font-size: .85rem; }
  .footer__bottom span { display: inline; }
  .footer__bottom a { display: inline; }

  .mobile-bar { display: none; }
  @media (max-width: 720px) {
    .mobile-bar { display: grid; grid-template-columns: 1fr 1fr 1.3fr; position: fixed; inset: auto 0 0; z-index: 40; background: #fff; border-top: 1px solid var(--line); box-shadow: 0 -6px 20px rgba(0,0,0,.08); }
    .mobile-bar a { display: flex; align-items: center; justify-content: center; gap: 6px; padding: 14px 6px; font-family: var(--font-title); font-weight: 700; font-size: .88rem; color: var(--navy); text-decoration: none; }
    .mobile-bar__cta { background: var(--blue); color: #fff !important; }
    body { padding-bottom: 56px; }
  }

  .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
  .reveal.in { opacity: 1; transform: none; }
  html:not(.js) .reveal { opacity: 1; transform: none; }
</style>
