---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import OfferGrid from '../components/OfferGrid.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { offersPros, servicesPros, launchOffers, professionnels } from '../data/site';
const included = professionnels.atouts.map((r) => ({ icon: r.icone, title: r.titre, text: r.texte }));
---
<Base title="Vidéo et photo drone pour professionnels en Vendée : immobilier, tourisme, entreprise"
  description="Prises de vue aériennes pour l'immobilier, le tourisme, les entreprises et les événements en Vendée. Télépilote certifié, droits commerciaux inclus, livraison rapide. Dès 190 €.">
  <PageHero eyebrow="Professionnels" title={professionnels.titre}
    lead={professionnels.introduction}>
    <div class="btn-row" style="margin-top:28px">
      <a class="btn btn--primary" href="/devis/?profil=pros">Obtenir un devis sous 48 h</a>
      <a class="btn btn--ghost" href="#offres">Voir les offres</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Secteurs</span>
        <h2>Ce que le drone apporte à votre activité</h2>
      </div>
      <div class="grid grid-3">
        {servicesPros.map((s) => (
          <div class="card reveal" id={s.id} style="scroll-margin-top:100px"><h3>{s.title}</h3><p>{s.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="section-head reveal">
        <span class="eyebrow">Travailler avec Droneo</span>
        <h2>Un prestataire fiable, sans mauvaise surprise</h2>
      </div>
      <div class="grid grid-4">
        {included.map((r) => (
          <div class="card reveal"><div class="icon"><Icon name={r.icon} /></div><h3>{r.title}</h3><p>{r.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="offres">
    <div class="wrap">
      <div class="section-head section-head--center reveal">
        <span class="eyebrow">Offres</span>
        <h2>Des formules pensées pour les pros</h2>
        <p class="lead">Un prix de départ clair, ajusté à votre besoin dans le devis.</p>
      </div>
      <OfferGrid offers={offersPros} audience="pros" />
      {launchOffers.pros && <div class="promo reveal"><span class="play play--sm"></span>{launchOffers.pros}</div>}
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap split">
      <div class="reveal">
        <span class="eyebrow">Partenaires</span>
        <h2>{professionnels.partenairesTitre}</h2>
        <p class="lead">{professionnels.partenairesTexte}</p>
        <a class="btn btn--outline" href="/devis/?profil=pros&formule=Partenariat">Proposer un partenariat</a>
      </div>
      <div class="card reveal">
        <h3>Clients récurrents</h3>
        <p>{professionnels.recurrentsTexte}</p>
      </div>
    </div>
  </section>

  <CtaBand title="Parlons de votre projet" text="Décrivez votre besoin en 2 minutes, recevez un devis détaillé sous 48 h." href="/devis/?profil=pros" label="Obtenir mon devis" />
</Base>
