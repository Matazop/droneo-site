---
interface Props { eyebrow?: string; title: string; lead?: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="page-hero">
  <img class="bg-mark" src="/img/logo-mark-dark.png" alt="" />
  <div class="wrap">
    {eyebrow && <span class="eyebrow" style="color:#5fb0ff">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</section>
